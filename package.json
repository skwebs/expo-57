{
  "name": "my-wallet",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.9",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "expo": "~57.0.11",
    "expo-constants": "~57.0.3",
    "expo-dev-client": "~57.0.8",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-keep-awake": "~57.0.0",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.11",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "nativewind": "^5.0.0-preview.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.2",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.16",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "reset-project": "node ./scripts/reset-project.js",
    "dev": "cross-env APP_VARIANT=development expo start --dev-client",
    "android": "cross-env APP_VARIANT=development expo run:android",
    "android:preview": "cross-env APP_VARIANT=preview expo run:android",
    "android:prod": "cross-env APP_VARIANT=production expo run:android",
    "prebuild": "cross-env APP_VARIANT=development expo prebuild",
    "prebuild:clean": "cross-env APP_VARIANT=development expo prebuild --clean",
    "prebuild:preview": "cross-env APP_VARIANT=preview expo prebuild --clean",
    "prebuild:prod": "cross-env APP_VARIANT=production expo prebuild --clean",
    "ios": "cross-env APP_VARIANT=development expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "kill": "npx kill-port 8081",
    "build:debug": "cd android && gradlew.bat assembleDebug",
    "build:release": "cd android && gradlew.bat assembleRelease",
    "build:apk": "cross-env APP_VARIANT=production expo prebuild --clean && cd android && gradlew.bat assembleRelease",
    "build:aab": "cross-env APP_VARIANT=production expo prebuild --clean && cd android && gradlew.bat bundleRelease"
  },
  "private": true,
  "overrides": {
    "lightningcss": "1.30.1"
  }
}
